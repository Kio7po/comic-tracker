    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "ComicTrackerApplication",
            "request": "launch",
            "mainClass": "com.github.kio7po.comic_tracker.ComicTrackerApplication",
            "projectName": "comic-tracker",
            "vmArgs": "-Dspring.profiles.active=dev",
            "envFile": "${workspaceFolder}/backend/.env"
        }
    ]
}